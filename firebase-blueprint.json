{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile holding core credentials and role",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"] },
        "institutionId": { "type": "string" },
        "institutionName": { "type": "string" },
        "studentIdNumber": { "type": "string" },
        "facultyIdNumber": { "type": "string" },
        "employeeId": { "type": "string" },
        "department": { "type": "string" },
        "approvalStatus": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "emailVerified": { "type": "boolean" },
        "profilePhoto": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "phone": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "college": { "type": "string" },
        "stream": { "type": "string" },
        "year": { "type": "string" },
        "bio": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["userId", "name", "email", "role", "createdAt"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Detailed academic and knowledge profile for a student",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "enrolledCourses": { "type": "array" },
        "completedAssessments": { "type": "number" },
        "overallPerformance": { "type": "number" },
        "strengths": { "type": "array" },
        "weaknesses": { "type": "array" },
        "knowledgeProfile": { "type": "object" },
        "learningStreak": { "type": "number" },
        "lastAssessment": { "type": "string" }
      },
      "required": ["studentId"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Teacher teaching specialties and stats",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "subjects": { "type": "array" },
        "createdAssessments": { "type": "number" },
        "uploadedMaterials": { "type": "number" },
        "students": { "type": "number" }
      },
      "required": ["teacherId"]
    },
    "Material": {
      "title": "Material",
      "description": "Uploaded study material and extracted pedagogical structure",
      "type": "object",
      "properties": {
        "materialId": { "type": "string" },
        "teacherId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "storagePath": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "uploadDate": { "type": "string" },
        "processingStatus": { "type": "string", "enum": ["uploaded", "processing", "processed", "failed"] },
        "extractedText": { "type": "string" },
        "structuredConcepts": { "type": "array" }
      },
      "required": ["materialId", "teacherId", "fileName", "subject", "topic", "processingStatus"]
    },
    "Question": {
      "title": "Question",
      "description": "Question bank item generated by AI or created by teacher",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "teacherId": { "type": "string" },
        "questionText": { "type": "string" },
        "type": { "type": "string", "enum": ["mcq", "true_false", "fill_in_the_blank", "short_answer"] },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "concept": { "type": "string" },
        "learningObjective": { "type": "string" },
        "sourceMaterialId": { "type": "string" },
        "createdBy": { "type": "string", "enum": ["AI", "teacher"] },
        "status": { "type": "string", "enum": ["draft", "ai_generated", "approved", "rejected", "archived"] },
        "createdAt": { "type": "string" }
      },
      "required": ["questionId", "teacherId", "questionText", "type", "correctAnswer", "difficulty", "topic", "status"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Published or draft quiz/exam configured by teacher",
      "type": "object",
      "properties": {
        "assessmentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "topics": { "type": "array" },
        "questionCount": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "passingPercentage": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "questionIds": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "createdAt": { "type": "string" }
      },
      "required": ["assessmentId", "teacherId", "title", "subject", "questionCount", "durationMinutes", "passingPercentage", "status"]
    },
    "AssessmentAttempt": {
      "title": "AssessmentAttempt",
      "description": "Student exam instance with answers and server evaluation",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string" },
        "assessmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "questionIds": { "type": "array" },
        "startedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["in_progress", "submitted", "expired"] },
        "answers": { "type": "object" },
        "score": { "type": "number" },
        "percentage": { "type": "number" },
        "passed": { "type": "boolean" },
        "topicBreakdown": { "type": "object" },
        "difficultyBreakdown": { "type": "object" },
        "proctoringViolationsCount": { "type": "number" }
      },
      "required": ["attemptId", "assessmentId", "studentId", "startedAt", "status"]
    },
    "ProctoringEvent": {
      "title": "ProctoringEvent",
      "description": "Browser assessment monitoring event logged during exam",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "attemptId": { "type": "string" },
        "studentId": { "type": "string" },
        "eventType": { "type": "string", "enum": ["tab_switch", "fullscreen_exit", "window_blur", "copy_attempt", "paste_attempt", "context_menu"] },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["eventId", "attemptId", "studentId", "eventType", "timestamp"]
    },
    "LearningPlan": {
      "title": "LearningPlan",
      "description": "AI-generated tailored remediation plan based on assessment gaps",
      "type": "object",
      "properties": {
        "planId": { "type": "string" },
        "studentId": { "type": "string" },
        "generatedAt": { "type": "string" },
        "weakConcepts": { "type": "array" },
        "priorityTopics": { "type": "array" },
        "recommendedSequence": { "type": "array" },
        "practiceRecommendations": { "type": "array" },
        "explanation": { "type": "string" }
      },
      "required": ["planId", "studentId", "generatedAt", "explanation"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for alerts and results",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "assessment", "result", "recommendation"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["notificationId", "userId", "title", "message", "type", "read", "createdAt"]
    },
    "Timetable": {
      "title": "Timetable",
      "description": "Weekly academic schedule and slots",
      "type": "object",
      "properties": {
        "timetableId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "term": { "type": "string" },
        "slots": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["timetableId", "userId", "slots"]
    },
    "CustomRoadmap": {
      "title": "CustomRoadmap",
      "description": "AI-synthesized custom learning roadmap graph",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "phases": { "type": "array" },
        "nodes": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "nodes"]
    },
    "RoadmapProgress": {
      "title": "RoadmapProgress",
      "description": "Completed node IDs and roadmap tracking per student",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "completedNodeIds": { "type": "array" },
        "activeRoadmapId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "AIChatSession": {
      "title": "AIChatSession",
      "description": "Student tutor or teacher agent conversation session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher"] },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "messages"]
    },
    "QuickNote": {
      "title": "QuickNote",
      "description": "AI-synthesized study notes page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "chapterName": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "summary": { "type": "string" },
        "tips": { "type": "array" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "chapterName"]
    },
    "InProgressExam": {
      "title": "InProgressExam",
      "description": "Live auto-saved exam answers and remaining duration",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string" },
        "assessmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "answers": { "type": "object" },
        "currentIndex": { "type": "number" },
        "timeLeft": { "type": "number" },
        "flaggedIndices": { "type": "array" },
        "proctoringEvents": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["attemptId", "assessmentId", "studentId"]
    },
    "WorkflowStudioState": {
      "title": "WorkflowStudioState",
      "description": "Teacher custom studio tabs and session scripts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tabs": { "type": "array" },
        "sessions": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "PlanMilestones": {
      "title": "PlanMilestones",
      "description": "Student completed milestone IDs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "completedMilestoneIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User basic profile and role definition"
    },
    "/studentProfiles/{studentId}": {
      "schema": "StudentProfile",
      "description": "Comprehensive knowledge and performance profile of a student"
    },
    "/teacherProfiles/{teacherId}": {
      "schema": "TeacherProfile",
      "description": "Teacher specialties and course references"
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Uploaded course materials and concept decompositions"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Approved and draft question items"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Teacher-designed assessments and exams"
    },
    "/assessmentAttempts/{attemptId}": {
      "schema": "AssessmentAttempt",
      "description": "Exam submissions and real-time student answers"
    },
    "/inProgressExams/{attemptId}": {
      "schema": "InProgressExam",
      "description": "Auto-saved active exam progress state"
    },
    "/proctoringEvents/{eventId}": {
      "schema": "ProctoringEvent",
      "description": "Monitored browser security signals"
    },
    "/learningPlans/{planId}": {
      "schema": "LearningPlan",
      "description": "AI-synthesized personalized roadmaps and recommendations"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User alerts and updates"
    },
    "/timetables/{timetableId}": {
      "schema": "Timetable",
      "description": "Weekly course timetable configuration"
    },
    "/customRoadmaps/{roadmapId}": {
      "schema": "CustomRoadmap",
      "description": "AI-synthesized interactive learning roadmaps"
    },
    "/roadmapProgress/{userId}": {
      "schema": "RoadmapProgress",
      "description": "Per-student node completion in roadmap tracks"
    },
    "/aiChatSessions/{sessionId}": {
      "schema": "AIChatSession",
      "description": "Multi-turn student and teacher AI dialogue sessions"
    },
    "/quickNotes/{noteId}": {
      "schema": "QuickNote",
      "description": "Synthesized high-yield quick notes pages"
    },
    "/workflowStudio/{userId}": {
      "schema": "WorkflowStudioState",
      "description": "Teacher AI workflow studio state"
    },
    "/planMilestones/{userId}": {
      "schema": "PlanMilestones",
      "description": "User learning plan milestone completion"
    },
    "/students/{studentId}": {
      "schema": "StudentProfile",
      "description": "Isolated role-partitioned student records and progression"
    },
    "/teachers/{teacherId}": {
      "schema": "TeacherProfile",
      "description": "Isolated role-partitioned teacher records and subject allocations"
    },
    "/admins/{adminId}": {
      "schema": "User",
      "description": "Isolated role-partitioned admin governance credentials"
    }
  }
}
